{
  "schemaVersion": 1,
  "title": "Prepare fresh v3 BDS-only archived control (no start)",
  "steps": [
    {
      "name": "v3_archive_task_selftest",
      "runtime": "python",
      "script": "games/minecraft-ai/scripts/alice-v3-control-prepare-task.py",
      "args": [
        "--self-test"
      ],
      "timeoutSeconds": 15
    },
    {
      "name": "v3_newonly_archive_prepare",
      "runtime": "python",
      "script": "games/minecraft-ai/scripts/alice-v3-control-prepare-task.py",
      "args": [
        "--prepare",
        "@output_dir"
      ],
      "timeoutSeconds": 440
    }
  ],
  "artifacts": [
    {
      "id": "v3_archive",
      "file": "alice_v3_prepare.json",
      "format": "json"
    }
  ]
}
