{
  "schemaVersion": 1,
  "title": "Read only Mint memory and dedicated new UDP ports 17882/27882 for isolated Alice BDS test",
  "steps": [
    {
      "name": "selftest",
      "runtime": "python",
      "script": "games/minecraft-ai/scripts/alice-isolated-bds-readiness.py",
      "args": [
        "--self-test"
      ],
      "timeoutSeconds": 15
    },
    {
      "name": "read_host_capacity",
      "runtime": "python",
      "script": "games/minecraft-ai/scripts/alice-isolated-bds-readiness.py",
      "args": [
        "--check",
        "@output_dir"
      ],
      "timeoutSeconds": 50
    }
  ],
  "artifacts": [
    {
      "id": "capacity",
      "file": "isolated_bds_capacity.json",
      "format": "json"
    }
  ]
}
