      "name": "start_contract",
      "runtime": "python",
      "script": "games/minecraft-ai/scripts/alice-17879-client-start-gated.py",
      "args": [
        "--self-test"
      ],
      "timeoutSeconds": 12
    },
    {
      "name": "original_world_preflight",
      "runtime": "python",
      "script": "games/minecraft-ai/scripts/alice-17879-client-start-gated.py",
      "args": [
        "--check",
