{
  "schemaVersion": 1,
  "title": "Only inspect whether existing Alice client reloaded current witness idle resume without restarting",
  "steps": [
    {
      "name": "selftest",
      "runtime": "python",
      "script": "games/minecraft-ai/scripts/alice-mcsm-reload-audit-readonly.py",
      "args": [
        "--self-test"
      ],
      "timeoutSeconds": 12
    },
    {
      "name": "read_client_live",
      "runtime": "python",
      "script": "games/minecraft-ai/scripts/alice-mcsm-reload-audit-readonly.py",
      "args": [
        "--check",
        "@output_dir"
      ],
      "timeoutSeconds": 55
    }
  ],
  "artifacts": [
    {
      "id": "client_audit",
      "file": "alice_mcsm_reload_audit.json",
      "format": "json"
    }
  ]
}
