{
  "schemaVersion": 1,
  "title": "Alice 17879 read-only real collision shape and wooden door state from current private client snapshot",
  "steps": [
    {
      "name": "shape_reader_selftest",
      "runtime": "python",
      "script": "games/minecraft-ai/scripts/alice-collision-shape-readonly.py",
      "args": [
        "--self-test"
      ],
      "timeoutSeconds": 15
    },
    {
      "name": "inspect_current_collision",
      "runtime": "python",
      "script": "games/minecraft-ai/scripts/alice-collision-shape-readonly.py",
      "args": [
        "--read",
        "@output_dir"
      ],
      "timeoutSeconds": 75
    }
  ],
  "artifacts": [
    {
      "id": "collision",
      "file": "collision_shape_readonly.json",
      "format": "json"
    }
  ]
}
