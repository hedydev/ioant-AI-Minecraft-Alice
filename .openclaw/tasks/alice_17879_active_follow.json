{
  "schemaVersion": 1,
  "title": "Two read-only active FOLLOW telemetry snapshots on current world",
  "steps": [
    {
      "name": "active_follow_selftest",
      "runtime": "python",
      "script": "games/minecraft-ai/scripts/alice-17879-active-follow-readonly.py",
      "args": [
        "--self-test"
      ],
      "timeoutSeconds": 12
    },
    {
      "name": "active_follow_readonly",
      "runtime": "python",
      "script": "games/minecraft-ai/scripts/alice-17879-active-follow-readonly.py",
      "args": [
        "--inspect",
        "@output_dir"
      ],
      "timeoutSeconds": 54
    }
  ],
  "artifacts": [
    {
      "id": "active_follow",
      "file": "active_follow.json",
      "format": "json"
    }
  ]
}
