{
  "schemaVersion": 1,
  "title": "Owner-verified live door priority versus BDS step, pure read-only",
  "steps": [
    {
      "name": "door_diagnostic_selftest",
      "runtime": "python",
      "script": "games/minecraft-ai/scripts/alice-door-lifecycle-readonly.py",
      "args": [
        "--self-test"
      ],
      "timeoutSeconds": 12
    },
    {
      "name": "door_diagnostic_current_pid",
      "runtime": "python",
      "script": "games/minecraft-ai/scripts/alice-door-lifecycle-readonly.py",
      "args": [
        "--read",
        "@output_dir"
      ],
      "timeoutSeconds": 70
    }
  ],
  "artifacts": [
    {
      "id": "door_audit",
      "file": "alice_door_autonomy.json",
      "format": "json"
    }
  ]
}
