{
  "schemaVersion": 1,
  "title": "Alice v3 BDS-only control preflight without sudo or BDS",
  "steps": [
    {
      "name": "v3_control_audit_selftest",
      "runtime": "python",
      "script": "games/minecraft-ai/scripts/alice-v3-control-audit-task.py",
      "args": [
        "--self-test"
      ],
      "timeoutSeconds": 12
    },
    {
      "name": "v3_control_safe_audit",
      "runtime": "python",
      "script": "games/minecraft-ai/scripts/alice-v3-control-audit-task.py",
      "args": [
        "--check",
        "@output_dir"
      ],
      "timeoutSeconds": 45
    }
  ],
  "artifacts": [
    {
      "id": "v3_control_audit",
      "file": "alice_v3_control_audit.json",
      "format": "json"
    }
  ]
}
