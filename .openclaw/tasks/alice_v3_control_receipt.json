      "runtime": "python",
      "script": "games/minecraft-ai/scripts/alice-v3-control-receipt-read.py",
      "args": [
        "--read",
        "@output_dir"
      ],
      "timeoutSeconds": 45
    }
  ],
  "artifacts": [
    {
      "id": "v3_control_receipt",
      "file": "alice_v3_control_receipt.json",
